datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 1. IDENTITY, ROLES & SESSIONS (BETTER AUTH POSTGRESQL NATIVE)
// =========================================================================

enum Role {
  CUSTOMER
  SUPPORT
  MANAGER
  OWNER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  emailVerified       Boolean          @default(false)
  image               String?
  phone               String?          @unique
  phoneVerified       Boolean          @default(false)
  role                Role             @default(CUSTOMER)
  status              UserStatus       @default(ACTIVE)
  twoFactorEnabled    Boolean          @default(false)
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  version             Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  accounts            Account[]
  sessions            Session[]
  twoFactorSecret     TwoFactorSecret?
  backupCodes         BackupCode[]
  addresses           Address[]
  orders              Order[]
  reviews             Review[]
  invitesSent         StaffInvite[]    @relation("InvitedByStaff")
  auditLogs           AuditLog[]       @relation("ActorAuditLogs")

  @@index([email])
  @@index([phone])
  @@index([role, status])
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  passwordHash          String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  passwordResetRequired Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  tokenHash  String   @unique
  type       String   // EMAIL_VERIFICATION, PASSWORD_RESET, OTP_LOGIN
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model StaffInvite {
  id          String    @id @default(uuid())
  email       String    @unique
  role        Role
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("InvitedByStaff", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}

model TwoFactorSecret {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretKey String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, used])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  Role
  action     String
  resource   String
  resourceId String?
  diffJson   Json?
  ipAddress  String
  userAgent  String
  status     String   @default("SUCCESS")
  timestamp  DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([timestamp(sort: Desc)])
}
