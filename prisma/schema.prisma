datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 1. IDENTITY, SESSIONS & ROLES (BETTER AUTH + RBAC ARCHITECTURE)
// =========================================================================

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  emailVerified       Boolean          @default(false)
  image               String?
  phone               String?          @unique
  phoneVerified       Boolean          @default(false)
  role                String           @default("CUSTOMER") // CUSTOMER, SUPPORT, MANAGER, OWNER
  status              String           @default("ACTIVE")   // ACTIVE, INVITED, SUSPENDED, DEACTIVATED
  twoFactorEnabled    Boolean          @default(false)
  banned              Boolean?         @default(false)
  banReason           String?
  banExpires          DateTime?
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  version             Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now()) @updatedAt

  accounts            Account[]
  sessions            Session[]
  twoFactorSecret     TwoFactorSecret?
  twoFactor           TwoFactor?       @relation("BetterAuthTwoFactor")
  backupCodes         BackupCode[]
  addresses           Address[]
  orders              Order[]
  reviews             Review[]
  invitesSent         StaffInvite[]    @relation("InvitedByStaff")
  auditLogs           AuditLog[]       @relation("ActorAuditLogs")
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  passwordHash          String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  passwordResetRequired Boolean   @default(false)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([providerId, accountId])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  tokenHash  String   @unique
  type       String   // EMAIL_VERIFICATION, PASSWORD_RESET, OTP_LOGIN
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

model StaffInvite {
  id          String    @id @default(uuid())
  email       String    @unique
  role        String    // SUPPORT, MANAGER, OWNER
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("InvitedByStaff", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model TwoFactorSecret {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretKey String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  String   // OWNER, MANAGER, SUPPORT, SYSTEM
  action     String   // LOGIN, LOGOUT, ROLE_CHANGE, REFUND_ISSUED, SETTING_UPDATE, etc.
  resource   String   // User, Order, Product, Coupon, System
  resourceId String?
  diffJson   String?  // Structured before/after diff in JSON string
  ipAddress  String
  userAgent  String
  status     String   @default("SUCCESS") // SUCCESS, FAILURE, BLOCKED
  timestamp  DateTime @default(now())
}

// Legacy tables preserved for zero-downtime migration
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPER_ADMIN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Customer {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  totalOrders  Int       @default(0)
  totalSpend   Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  orders       Order[]
  addresses    Address[]
}

model Address {
  id           String    @id @default(uuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pinCode      String
  country      String    @default("India")
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

// =========================================================================
// 2. STORE, CATALOG & OPTIMISTIC CONCURRENCY
// =========================================================================

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  products     Product[]
}

model Collection {
  id           String              @id @default(uuid())
  name         String
  slug         String              @unique
  description  String?
  image        String?
  bannerImage  String?
  displayOrder Int                 @default(0)
  active       Boolean             @default(true)
  version      Int                 @default(1)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  products     ProductCollection[]
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  sku                String?             @unique
  shortDescription   String?
  fullDescription    String?
  regularPrice       Float
  salePrice          Float?
  costPrice          Float?
  tax                Float?              @default(0)
  stockQuantity      Int                 @default(100)
  lowStockThreshold  Int                 @default(10)
  trackInventory     Boolean             @default(true)
  allowBackorders    Boolean             @default(false)
  isFeatured         Boolean             @default(false)
  isBestSeller       Boolean             @default(false)
  isNew              Boolean             @default(false)
  isOnSale           Boolean             @default(false)
  hasTimer           Boolean             @default(false)
  active             Boolean             @default(true)
  displayOrder       Int                 @default(0)
  rating             Float               @default(4.9)
  reviewCount        Int                 @default(0)
  benefits           String?
  howToUse           String?
  faqJson            String?
  seoTitle           String?
  seoDescription     String?
  version            Int                 @default(1) // Optimistic lock
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  
  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  collections        ProductCollection[]
  ingredients        ProductIngredient[]
  reviews            Review[]
  orderItems         OrderItem[]
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  displayOrder Int      @default(0)
  isThumbnail  Boolean  @default(false)
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Ingredient {
  id               String              @id @default(uuid())
  name             String
  slug             String              @unique
  image            String?
  shortDescription String?
  fullDescription  String?
  benefits         String?
  displayOrder     Int                 @default(0)
  active           Boolean             @default(true)
  products         ProductIngredient[]
}

model ProductIngredient {
  productId    String
  ingredientId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model InventoryLog {
  id            String   @id @default(uuid())
  productId     String
  changeAmount  Int
  type          String   // RESTOCK, ORDER, ADJUSTMENT, RETURN
  notes         String?
  createdAt     DateTime @default(now())
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String?
  rating             Int      @default(5)
  title              String?
  content            String
  images             String?  // JSON string array
  isVerifiedPurchase Boolean  @default(true)
  isApproved         Boolean  @default(true)
  isFeatured         Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue  Float
  minOrderValue  Float?    @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  isPublic       Boolean   @default(true)
  creatorName    String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

// =========================================================================
// 3. ORDERS, PAYMENTS & REFUNDS
// =========================================================================

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id])
  customerName     String
  customerEmail    String
  customerPhone    String
  guestAccessToken String?         // Signed HMAC token for guest tracking links
  shippingAddress  String          // JSON string snapshot
  billingAddress   String?         // JSON string
  subtotal         Float
  discount         Float           @default(0)
  shippingFee      Float           @default(0)
  tax              Float           @default(0)
  total            Float
  couponCode       String?
  paymentMethod    String          @default("COD") // COD or RAZORPAY
  paymentStatus    String          @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  orderStatus      String          @default("CONFIRMED") // PENDING, CONFIRMED, PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, REFUNDED
  trackingNumber   String?
  trackingUrl      String?
  carrier          String?         @default("Shiprocket")
  notes            String?
  advanceAmount           Float           @default(0)
  codBalanceAmount        Float?          @default(0)
  advancePaymentId        String?
  advancePaidAt           DateTime?
  advanceSettingsSnapshot String?
  shippingMode            String?         @default("delhivery_pending") // delhivery_pending or auto_manifest
  delhiverySyncStatus     String?         @default("PENDING_DISPATCH") // PENDING_DISPATCH, SYNCED, FAILED
  delhiverySyncAttempts   Int             @default(0)
  delhiverySyncError      String?
  lastDelhiverySyncAt     DateTime?
  delhiveryStatus         String?         // PENDING, READY_TO_SHIP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RTO
  pickupStatus        String          @default("NONE") // NONE, REQUESTED, SCHEDULED, FAILED, PICKED
  pickupRequestId     String?
  pickupDate          DateTime?
  pickupTime          String?
  pickupError         String?
  pickupAttempts      Int             @default(0)
  lastPickupAttemptAt DateTime?
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  items            OrderItem[]
  events           ShipmentEvent[]
  refunds          RefundRequest[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  productName  String
  productImage String?
  price        Float
  quantity     Int
  total        Float
}

model RefundRequest {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED
  requestedBy String   // Staff ID
  approvedBy  String?  // OWNER ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String
  timestamp   DateTime @default(now())
}

// =========================================================================
// 4. CONTENT, FAQ, PROMOS & SETTINGS
// =========================================================================

model HomepageSection {
  id           String    @id @default(uuid())
  sectionType  String
  title        String?
  subtitle     String?
  contentJson  String
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  offerEndsAt  DateTime? // Time bounds for promotional countdowns
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

model CustomerResult {
  id           String   @id @default(uuid())
  customerName String
  productTitle String?
  beforeImage  String?
  afterImage   String
  caption      String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SocialPost {
  id           String   @id @default(uuid())
  instagramUrl String?
  videoUrl     String?
  thumbnailUrl String
  caption      String?
  productTitle String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model BlogPost {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  featuredImage  String?
  excerpt        String
  content        String
  author         String    @default("Herbicas Ayurvedic Team")
  category       String    @default("Hair Care")
  tags           String?
  seoTitle       String?
  seoDescription String?
  published      Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model FAQ {
  id           String   @id @default(uuid())
  question     String
  answer       String
  category     String   @default("GENERAL")
  placement    String   @default("HOMEPAGE")
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  name      String
  url       String
  alt       String?
  sizeBytes Int?
  mimeType  String?  @default("image/jpeg")
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  source       String   @default("HOMEPAGE_FOOTER")
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

// =========================================================================
// 8. TECHNICAL SEO & URL REDIRECT ENGINE
// =========================================================================

model Redirect {
  id          String   @id @default(uuid())
  source      String   @unique
  destination String
  statusCode  Int      @default(301)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model TwoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation("BetterAuthTwoFactor", fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt
}
